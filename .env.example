# --- Browser-safe (shipped to the client, public by design) --------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_ASTROLOGY_ENGINE_URL=
# Must be a real public.astrologers.id. There is no seeded astrologer any more —
# create one per README section 8 and paste its id here.
NEXT_PUBLIC_DEFAULT_ASTROLOGER_ID=

# --- Server-side only: Supabase Edge Function secrets --------------------------
# NEVER prefix any of these with NEXT_PUBLIC_ and never place them in
# public/site-assets/. Set them with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Direct Postgres connection, used only by scripts/db.mjs to apply database/
# migrations and tests. Dashboard > Project Settings > Database > Connection string > URI.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Which project SUPABASE_URL / SUPABASE_DB_URL point at. scripts/db.mjs refuses to run
# unless this is "development"; a production run needs "production" AND --production.
SUPABASE_DB_TARGET=development

# Added in later steps of docs/IMPLEMENTATION-PLAN.md:
# RESEND_API_KEY=            # Step 16, email jobs
# LIVEKIT_API_KEY=           # Step 18, consultation join tokens
# LIVEKIT_API_SECRET=        # Step 18
# LIVEKIT_URL=               # Step 18
